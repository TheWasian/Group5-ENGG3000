#=========================================
# KiCad Gitignore Template
#=========================================

# Temporary and auto-save files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck

# Netlist and internal router files (usually not tracked)
*.net
*.dsn
*.ses

# Exported files (uncomment if you want to skip tracking them)
# *.xml
# *.csv

# Archived auto-backups (KiCad 6.0+)
**/*-backups/*.zip

# Local project settings (Window positions, active layers, etc.)
*.kicad_prl

# Local git-based history (KiCad 9.0+)
.history/

